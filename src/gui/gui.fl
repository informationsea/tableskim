Function {show_github()} {open private
} {
  code {char message[256] = "";
if (!fl_open_uri("https://github.com/informationsea/tableskim", message, sizeof(message)))
    fl_alert("Cannot open the web browser:\\n%s", escapeLabel(message).c_str());} {}
}

