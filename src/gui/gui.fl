    code {// Closing goes through hide() so that the Window menu is updated. FLTK
// also calls this for an Escape key no widget used, which must not close it.
main_window->callback([](Fl_Widget *, void *data) {
  if (Fl::callback_reason() != FL_REASON_CANCELLED)
    static_cast<TableWindow *>(data)->close_window();
}, this);
tile->size_range(tab, 200, 50);
tile->size_range(sidebar_tab, 80, 50);
\#ifdef __APPLE__
tile->resize(0, 0, main_window->w(), main_window->h());
// The application menu already has Quit (Cmd+Q).
menuitem_quit->hide();
menuitem_show_in_file_browser->flags &= ~FL_MENU_DIVIDER;
\#endif
sidebar_buffer = std::make_unique<Fl_Text_Buffer>();
sidebar_text->buffer(*sidebar_buffer);
sidebar_text->wrap_mode(Fl_Text_Display::WRAP_AT_BOUNDS, 0);
tab->callback([](Fl_Widget *, void *data) { static_cast<TableWindow *>(data)->current_sheet_changed(); }, this);
setup_search();
setup_filter();
set_show_sidebar(false);} {}
  }
  Function {open_data()} {open
  } {}
  Function {~TableWindow()} {} {
    code {Fl::remove_timeout(auto_revert_timeout, this);
delete main_window;} {}
  }
  Function {hide()} {open
  } {
    code {main_window->hide();
schedule_auto_revert();
requestClosedWindowCleanup();
requestWindowMenuUpdate();} {}
  }
  Function {show()} {} {
    code {main_window->show();
schedule_auto_revert();
requestWindowMenuUpdate();} {}
  }
