Function {make_version_window()} {open C
} {
  Fl_Window {} {
    label {Table Skim Version Info} open
    xywh {881 585 300 200} type Double align 80 resizable visible
  } {
    Fl_Box table_skim_title {
      label {Table Skim}
      private xywh {6 7 150 32} labelsize 24
    }
    Fl_Box table_skim_version {
      label version
      private xywh {156 7 138 32} labelsize 12 align 20
    }
    Fl_Button {} {
      label Github
      callback show_github
      xywh {144 163 64 22}
    }
    Fl_Button {} {
      label Close
      callback {o->window()->hide();}
      xywh {221 163 64 22}
    }
    Fl_Text_Display license_text_display {
      private xywh {15 47 270 104} resizable
    }
  }
  code {table_skim_version->label(TABLESKIM_VERSION "\\n" TABLESKIM_GIT_REVISION);
license_text_buffer = std::make_unique<Fl_Text_Buffer>();
license_text_display->buffer(*license_text_buffer);
license_text_buffer->insert(0, thirdPartyLicenses().data());} {}
}

