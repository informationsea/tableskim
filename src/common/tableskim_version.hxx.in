#ifndef _TABLESKIM_VERSION_HXX_
#define _TABLESKIM_VERSION_HXX_

#include "tableskim_git_revision.hxx"

// Generated by CMake from project(... VERSION ...); do not edit.
// TABLESKIM_VERSION stays numeric because packaging needs it that way;
// TABLESKIM_VERSION_FULL adds the git revision for display.
#define TABLESKIM_VERSION "@PROJECT_VERSION@"
#define TABLESKIM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TABLESKIM_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TABLESKIM_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define TABLESKIM_VERSION_FULL TABLESKIM_VERSION " (" TABLESKIM_GIT_REVISION ")"

#endif // _TABLESKIM_VERSION_HXX_
