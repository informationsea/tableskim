#ifndef _CP932_TABLE_HXX_
#define _CP932_TABLE_HXX_

#include <cstddef>
#include <cstdint>

// CP932 double-byte characters to Unicode (BMP), generated by
// tools/generate-cp932-table.py. Indexed by
// cp932LeadIndex(lead) * CP932_TRAIL_COUNT + cp932TrailIndex(trail);
// 0 marks an unmapped pair.
inline constexpr size_t CP932_LEAD_COUNT = 60;  // 0x81-0x9F, 0xE0-0xFC
inline constexpr size_t CP932_TRAIL_COUNT = 188; // 0x40-0xFC except 0x7F

extern const uint16_t CP932_TABLE[CP932_LEAD_COUNT * CP932_TRAIL_COUNT];

inline bool isCp932Lead(unsigned char b)
{
    return (b >= 0x81 && b <= 0x9F) || (b >= 0xE0 && b <= 0xFC);
}

inline bool isCp932Trail(unsigned char b)
{
    return b >= 0x40 && b <= 0xFC && b != 0x7F;
}

inline size_t cp932LeadIndex(unsigned char lead)
{
    return lead <= 0x9F ? lead - 0x81u : lead - 0xE0u + 31u;
}

inline size_t cp932TrailIndex(unsigned char trail)
{
    return trail < 0x7F ? trail - 0x40u : trail - 0x41u;
}

#endif // _CP932_TABLE_HXX_
