# Writes a C++ source holding files as byte arrays, for the GUI's help:
#
#   cmake -DBASE_DIR=<dir> -DFILES=<a|b|...> -DOUTPUT=<file.cxx> -P EmbedFiles.cmake
#
# FILES are relative to BASE_DIR, separated by '|'. The source defines
# EMBEDDED_HELP_FILES / EMBEDDED_HELP_FILE_COUNT (see gui_help.cxx).

string(REPLACE "|" ";" files "${FILES}")
# CMake regular expressions have no {n}.
string(REPEAT "[0-9a-f]" 64 line_of_hex)
set(arrays "")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    file(READ "${BASE_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    # 32 bytes per line, then each byte as 0xNN.
    string(REGEX REPLACE "(${line_of_hex})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # An empty file still needs an element.
    if(size EQUAL 0)
        set(hex "0x00")
    endif()
    string(APPEND arrays "const unsigned char file_${index}[] = {\n${hex}\n};\n")
    string(APPEND entries "    {\"${file}\", file_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedFiles.cmake; do not edit.
#include <cstddef>

struct EmbeddedHelpFile
{
    const char *path;
    const unsigned char *data;
    size_t size;
};

namespace
{
${arrays}} // namespace

extern const EmbeddedHelpFile EMBEDDED_HELP_FILES[] = {
${entries}};
extern const size_t EMBEDDED_HELP_FILE_COUNT = ${index};
")
# Leaves the output untouched when nothing changed, so it is not rebuilt.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
