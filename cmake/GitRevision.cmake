# Writes the git revision of SOURCE_DIR to OUTPUT as TABLESKIM_GIT_REVISION.
# Run with `cmake -P` on every build, so the revision follows new commits
# without reconfiguring; OUTPUT is only rewritten when the revision changes,
# so an unchanged revision triggers no recompilation.
#
# Inputs: SOURCE_DIR, OUTPUT, GIT_EXECUTABLE (may be empty).

set(revision "unknown")
if(GIT_EXECUTABLE)
    # A source tarball unpacked inside another repository must not pick up
    # that repository's revision.
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE toplevel_result
        OUTPUT_VARIABLE toplevel
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(toplevel_result EQUAL 0)
        file(REAL_PATH "${toplevel}" toplevel)
        file(REAL_PATH "${SOURCE_DIR}" source_dir)
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${toplevel}" toplevel)
            string(TOLOWER "${source_dir}" source_dir)
        endif()
    endif()
    if(toplevel_result EQUAL 0 AND toplevel STREQUAL source_dir)
        # --exclude='*' ignores tags, so the result is always the commit id
        # (CI checkouts are shallow and have no tags anyway).
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" describe --always --dirty --abbrev=8 --exclude=*
            WORKING_DIRECTORY "${SOURCE_DIR}"
            RESULT_VARIABLE describe_result
            OUTPUT_VARIABLE describe
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET)
        if(describe_result EQUAL 0 AND describe)
            set(revision "${describe}")
        endif()
    endif()
endif()

set(content "#ifndef _TABLESKIM_GIT_REVISION_HXX_
#define _TABLESKIM_GIT_REVISION_HXX_

// Generated by cmake/GitRevision.cmake on every build; do not edit.
#define TABLESKIM_GIT_REVISION \"${revision}\"

#endif // _TABLESKIM_GIT_REVISION_HXX_
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old_content)
else()
    set(old_content "")
endif()
if(NOT content STREQUAL old_content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
