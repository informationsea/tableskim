{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 26,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "unix-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (Ninja)",
            "inherits": "unix-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Ninja)",
            "inherits": "unix-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer (Ninja)",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "macos-x86_64",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-x86_64-debug",
            "displayName": "Debug for Intel Macs (Ninja; tests run under Rosetta on Apple silicon)",
            "inherits": ["macos-x86_64", "debug"]
        },
        {
            "name": "macos-x86_64-release",
            "displayName": "Release for Intel Macs (Ninja; tests run under Rosetta on Apple silicon)",
            "inherits": ["macos-x86_64", "release"]
        },
        {
            "name": "make-debug",
            "displayName": "Debug (Unix Makefiles)",
            "inherits": "unix-base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "make-release",
            "displayName": "Release (Unix Makefiles)",
            "inherits": "unix-base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vs-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "Debug (Ninja / MSVC, from a Developer Command Prompt)",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "Release (Ninja / MSVC, from a Developer Command Prompt)",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vs-debug",
            "displayName": "Debug (Visual Studio / MSVC)",
            "inherits": "vs-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs-release",
            "displayName": "Release (Visual Studio / MSVC)",
            "inherits": "vs-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "wasm-base",
            "hidden": true,
            "inherits": "unix-base",
            "generator": "Ninja",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
        },
        {
            "name": "wasm-debug",
            "displayName": "Debug (WebAssembly, Emscripten; source emsdk_env.sh first)",
            "inherits": "wasm-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "wasm-release",
            "displayName": "Release (WebAssembly, Emscripten; source emsdk_env.sh first)",
            "inherits": "wasm-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "macos-x86_64-debug",
            "configurePreset": "macos-x86_64-debug"
        },
        {
            "name": "macos-x86_64-release",
            "configurePreset": "macos-x86_64-release"
        },
        {
            "name": "make-debug",
            "configurePreset": "make-debug"
        },
        {
            "name": "make-release",
            "configurePreset": "make-release"
        },
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release"
        },
        {
            "name": "vs-debug",
            "configurePreset": "vs-debug",
            "configuration": "Debug",
            "jobs": 2
        },
        {
            "name": "vs-release",
            "configurePreset": "vs-release",
            "configuration": "Release",
            "jobs": 2
        },
        {
            "name": "wasm-debug",
            "configurePreset": "wasm-debug"
        },
        {
            "name": "wasm-release",
            "configurePreset": "wasm-release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug",
            "inherits": "test-base",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "inherits": "test-base",
            "configurePreset": "release"
        },
        {
            "name": "asan",
            "inherits": "test-base",
            "configurePreset": "asan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1",
                "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp"
            }
        },
        {
            "name": "macos-x86_64-debug",
            "inherits": "test-base",
            "configurePreset": "macos-x86_64-debug"
        },
        {
            "name": "macos-x86_64-release",
            "inherits": "test-base",
            "configurePreset": "macos-x86_64-release"
        },
        {
            "name": "make-debug",
            "inherits": "test-base",
            "configurePreset": "make-debug"
        },
        {
            "name": "make-release",
            "inherits": "test-base",
            "configurePreset": "make-release"
        },
        {
            "name": "msvc-debug",
            "inherits": "test-base",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "msvc-release",
            "inherits": "test-base",
            "configurePreset": "msvc-release"
        },
        {
            "name": "vs-debug",
            "inherits": "test-base",
            "configurePreset": "vs-debug",
            "configuration": "Debug"
        },
        {
            "name": "vs-release",
            "inherits": "test-base",
            "configurePreset": "vs-release",
            "configuration": "Release"
        },
        {
            "name": "wasm-debug",
            "inherits": "test-base",
            "configurePreset": "wasm-debug"
        },
        {
            "name": "wasm-release",
            "inherits": "test-base",
            "configurePreset": "wasm-release"
        }
    ]
}