{
  "name": "tableskim",
  "displayName": "TableSkim",
  "description": "A viewer for tables: CSV/TSV/VCF, Excel, Parquet, DuckDB, SQLite and JSON, with sorting, filters, statistics, charts and SQL",
  "version": "0.3.3",
  "publisher": "informationsea",
  "license": "AGPL-3.0-only",
  "private": true,
  "preview": true,
  "icon": "icon.png",
  "homepage": "https://informationsea.github.io/tableskim/",
  "bugs": {
    "url": "https://github.com/informationsea/tableskim/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/informationsea/tableskim"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "csv",
    "tsv",
    "parquet",
    "excel",
    "duckdb",
    "sqlite",
    "json",
    "table"
  ],
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "TableSkim reads files by their paths on disk."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "tableskim.table",
        "displayName": "TableSkim",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.ods"
          },
          {
            "filenamePattern": "*.duckdb"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "tableskim.text",
        "displayName": "TableSkim",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.vcf"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.zst"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "tableskim.open",
        "title": "Open in TableSkim",
        "category": "TableSkim"
      },
      {
        "command": "tableskim.reload",
        "title": "Reload File",
        "category": "TableSkim",
        "icon": "$(refresh)",
        "enablement": "activeCustomEditorId == tableskim.table || activeCustomEditorId == tableskim.text"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tableskim.reload",
          "when": "activeCustomEditorId == tableskim.table || activeCustomEditorId == tableskim.text"
        }
      ],
      "editor/title": [
        {
          "command": "tableskim.reload",
          "when": "activeCustomEditorId == tableskim.table || activeCustomEditorId == tableskim.text",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "tableskim.open",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "tableskim.open",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "build:engine": "node scripts/copy-engine.mjs",
    "build:webview": "npm --prefix ../web run build:vscode",
    "compile": "tsc -p .",
    "build": "npm run build:engine && npm run build:webview && npm run compile",
    "test": "node --test tests/engine.test.cjs tests/editor.test.cjs",
    "test:vscode": "node tests/integration/run.cjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "~6.0.3"
  }
}
